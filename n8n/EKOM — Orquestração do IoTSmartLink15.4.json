      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body ?? input;\n\nconst requiredFields = [\n  'change_id',\n  'specification_path',\n];\n\nconst missingFields = requiredFields.filter(field => {\n  const value = body[field];\n\n  return (\n    typeof value !== 'string' ||\n    value.trim() === ''\n  );\n});\n\nif (missingFields.length > 0) {\n  throw new Error(\n    `Campos obrigatórios ausentes: ${missingFields.join(', ')}`\n  );\n}\n\nconst event = body.event ?? 'submit_for_analysis';\n\nif (event !== 'submit_for_analysis') {\n  throw new Error(`Evento não suportado: ${event}`);\n}\n\nconst specificationPath = body.specification_path.trim();\n\nconst specificationMatch = specificationPath.match(\n  /^docs\\/specs\\/([A-Za-z0-9]+(?:-[A-Za-z0-9]+)*)\\.md$/\n);\n\nif (!specificationMatch) {\n  throw new Error(\n    'O caminho deve seguir docs/specs/<Nome>.md, ' +\n    'com segmentos alfanuméricos separados por hífen.'\n  );\n}\n\nconst specificationName = specificationMatch[1];\nconst branchSlug = specificationName.toLowerCase();\nconst workingBranch = `spec/${branchSlug}`;\n\nreturn [\n  {\n    json: {\n      event,\n      source: body.source ?? 'repository_command',\n\n      change_id: body.change_id.trim(),\n      specification_path: specificationPath,\n\n      repository_owner: 'iotsmartsys',\n      repository_name: 'IoTSmartLink15.4',\n\n      working_branch: workingBranch,\n      branch_source: 'specification_path',\n\n      revision:\n        typeof body.revision === 'string' &&\n        body.revision.trim() !== ''\n          ? body.revision.trim()\n          : null,\n\n      submitted_by:\n        typeof body.submitted_by === 'string' &&\n        body.submitted_by.trim() !== ''\n          ? body.submitted_by.trim()\n          : 'not_informed',\n\n      received_at: new Date().toISOString(),\n\n      phase: 'analysis',\n      allow_code_changes: false,\n      allow_main_changes: false,\n      require_architect_approval: true,\n    },\n  },\n];"
      },
