      "parameters": {
        "jsCode": "const request = $('Normalizar submissão EKOM').first().json;\nconst analysis = $('Consultar execução da análise').first().json;\nconst decision = $input.first().json.data;\n\nif (decision?.approved !== true) {\n  throw new Error('A implementação não foi aprovada pelo Arquiteto.');\n}\n\nif (\n  analysis.status !== 'completed' ||\n  analysis.conclusion !== 'success'\n) {\n  throw new Error(\n    'A implementação exige uma análise concluída com sucesso.'\n  );\n}\n\nif (\n  typeof decision.respondedAt !== 'string' ||\n  !decision.respondedAt\n) {\n  throw new Error('A decisão não possui horário de aprovação.');\n}\n\nreturn [\n  {\n    json: {\n      event: 'submit_for_implementation',\n      source: 'n8n_architect_approval',\n\n      change_id: request.change_id,\n      specification_path: request.specification_path,\n      working_branch: request.working_branch,\n\n      architect_authorization: true,\n      authorized_by: 'Marcelo Costa Miranda',\n      authorized_at: decision.respondedAt,\n\n      analysis_run_id: analysis.id,\n      analysis_url: analysis.html_url,\n      analysis_conclusion: analysis.conclusion,\n\n      allow_tests: false,\n      allow_hardware: false,\n    },\n  },\n];"
      },
