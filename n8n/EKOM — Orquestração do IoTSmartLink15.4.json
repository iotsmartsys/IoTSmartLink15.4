      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body ?? input;\n\nfunction requiredString(value, field) {\n  if (typeof value !== 'string' || !value.trim()) {\n    throw new Error(`Campo obrigatório inválido: ${field}`);\n  }\n\n  if (/[\\r\\n]/.test(value)) {\n    throw new Error(`O campo ${field} deve ocupar uma única linha`);\n  }\n\n  return value.trim();\n}\n\nconst event = requiredString(body.event, 'event');\nconst source = requiredString(body.source, 'source');\nconst workingBranch = requiredString(\n  body.working_branch,\n  'working_branch'\n);\nconst authorizedBy = requiredString(\n  body.authorized_by,\n  'authorized_by'\n);\n\nif (event !== 'submit_for_implementation') {\n  throw new Error(`Evento não suportado: ${event}`);\n}\n\nif (source !== 'repository_command') {\n  throw new Error(`Origem não suportada: ${source}`);\n}\n\nif (!/^spec\\/[a-z0-9]+(?:-[a-z0-9]+)*$/.test(workingBranch)) {\n  throw new Error(\n    `Branch incompatível com a convenção EKOM: ${workingBranch}`\n  );\n}\n\nif (body.allow_tests !== false) {\n  throw new Error('O workflow de implementação não autoriza coleta nem execução de testes');\n}\n\nif (body.allow_hardware !== false) {\n  throw new Error('O workflow de implementação não autoriza flash, monitor nem hardware');\n}\n\nreturn [\n  {\n    json: {\n      event,\n      source,\n      working_branch: workingBranch,\n      architect_authorization: true,\n      authorized_by: authorizedBy,\n      allow_tests: false,\n      allow_hardware: false,\n      received_at: new Date().toISOString(),\n    },\n  },\n];"
      },
