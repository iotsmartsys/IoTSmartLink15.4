menu "IoT154 Sensor"

    config IOT154_COORDINATOR_SEND_FAILURE_LIMIT
        int "Falhas de envio antes de novo pareamento"
        range 1 255
        default 3
        help
            Quantidade de ciclos de wake/deep sleep em que o sensor acorda
            pareado e nao consegue confirmar envio ao coordenador antes de
            limpar o pareamento salvo e procurar outro coordenador.

endmenu
